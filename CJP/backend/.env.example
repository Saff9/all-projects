# ─────────────────────────────────────────────────────────────
# CJP Backend — Environment Configuration Example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# Server port (default: 5000)
PORT=5000

# MongoDB connection string
# Local example: mongodb://127.0.0.1:27017/cjp
# Atlas example: mongodb+srv://user:pass@cluster.mongodb.net/cjp
MONGODB_URI=mongodb://127.0.0.1:27017/cjp

# Telegram Bot Token — get this from @BotFather
TELEGRAM_BOT_TOKEN=your_real_bot_token_here

# Environment mode: "development" (bypasses auth for local testing)
# or "production" (enforces real Telegram auth validation)
NODE_ENV=development

# Frontend URL — used for CORS whitelisting in production
# Example: https://yourdomain.com or https://your-app.vercel.app
FRONTEND_URL=http://localhost:3000
