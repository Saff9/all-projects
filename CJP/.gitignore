# ─────────────────────────────────────────
# CJP Project — .gitignore
# ─────────────────────────────────────────

# Node.js dependencies
node_modules/
**/node_modules/

# Environment files — NEVER commit these
.env
.env.local
.env.production
.env.development
**/.env
**/.env.local
**/.env.production

# Next.js build output
frontend/.next/
frontend/out/

# Package manager lock files (keep one consistent)
# package-lock.json
# yarn.lock

# OS generated files
.DS_Store
Thumbs.db
.DS_Store?
._*

# Editor directories and files
.vscode/
.idea/
*.swp
*.swo
*~

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# PM2 logs and pid
.pm2/
logs/

# Coverage directory
coverage/

# Temp files
tmp/
temp/
