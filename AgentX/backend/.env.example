# ──────────────────────────────────────────────────────────────────────────────
# AgentX Backend – Environment Variables Template
# Copy to .env and fill in values before running locally.
# On Render: set these in the dashboard (render.yaml syncs some automatically).
# NEVER commit .env to git.
# ──────────────────────────────────────────────────────────────────────────────

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=CHANGE_ME_TO_A_STRONG_RANDOM_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── App ───────────────────────────────────────────────────────────────────────
DEBUG=false
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8080"]

# ── Database (SQLite – no external DB needed) ─────────────────────────────────
DB_PATH=./agentx.db

# ── Agent Settings ────────────────────────────────────────────────────────────
MAX_AGENT_STEPS=15
AGENT_TIMEOUT_SECONDS=120
WORKSPACE_DIR=./workspace

# ── LLM Providers – set at least ONE ─────────────────────────────────────────
# Groq is FREE and very fast – recommended for getting started:
# https://console.groq.com → Create API Key
GROQ_API_KEY=your_groq_api_key_here

# OpenAI (GPT-4o-mini is fast and cheap)
OPENAI_API_KEY=

# Anthropic Claude
ANTHROPIC_API_KEY=

# Ollama (local models, zero cost) – e.g. http://localhost:11434
OLLAMA_BASE_URL=
