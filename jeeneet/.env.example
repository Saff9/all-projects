# .env.example
# Copy this file to .env.local and fill in your values

# Base URL of your deployed site (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://jee-hall-finder.vercel.app

# Secret key used to protect the /api/news/scrape POST endpoint
# Generate one with: openssl rand -hex 32
CRON_SECRET=your-super-secret-key-here

# SQLite database path (relative to project root)
# On Vercel use /tmp/jee.db (writable), locally use data/jee.db
DB_PATH=data/jee.db
