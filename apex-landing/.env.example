# Database Configuration (for production)
# Replace with your actual database URL when deploying
DATABASE_URL="your-database-url-here"

# Next.js Configuration
NEXT_PUBLIC_SITE_URL="https://your-domain.com"
NEXT_PUBLIC_API_URL="https://your-api-domain.com"

# Analytics & Tracking (optional)
NEXT_PUBLIC_GA_ID="your-google-analytics-id"
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-token"

# Email Service (for newsletter)
SMTP_HOST="your-smtp-host"
SMTP_PORT="587"
SMTP_USER="your-smtp-user"
SMTP_PASS="your-smtp-password"

# Social Media (for SEO)
NEXT_PUBLIC_TWITTER_HANDLE="@your-handle"
NEXT_PUBLIC_LINKEDIN_URL="https://linkedin.com/company/your-company"

# Content Management (optional, for headless CMS)
CONTENTFUL_SPACE_ID="your-contentful-space-id"
CONTENTFUL_ACCESS_TOKEN="your-contentful-access-token"
